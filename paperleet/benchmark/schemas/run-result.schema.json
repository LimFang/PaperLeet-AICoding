{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperleet.dev/schemas/benchmark-run-result-1.0.json",
  "title": "PaperLeet Benchmark Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "manifest",
    "metrics",
    "artifacts",
    "output",
    "stop_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "timed_out",
        "budget_exceeded",
        "cancelled"
      ]
    },
    "manifest": {
      "type": "object",
      "required": [
        "run_id",
        "created_at",
        "started_at",
        "finished_at",
        "task_id",
        "task_version",
        "fixture_digest",
        "protocol_version",
        "evaluator_version",
        "rubric_version",
        "runner_version",
        "provider",
        "model_id",
        "strategy",
        "strategy_version",
        "prompt_template_version",
        "prompt_hash",
        "output_schema_version",
        "seed",
        "seed_applied",
        "model_parameters",
        "budget_limits",
        "usage"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        },
        "task_version": {
          "type": "string"
        },
        "fixture_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "type": "string"
        },
        "evaluator_version": {
          "type": "string"
        },
        "rubric_version": {
          "type": "string"
        },
        "runner_version": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy": {
          "enum": [
            "S0",
            "S1",
            "S2",
            "S3",
            "DETERMINISTIC"
          ]
        },
        "strategy_version": {
          "type": "string"
        },
        "prompt_template_version": {
          "type": "string"
        },
        "prompt_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_schema_version": {
          "type": "string"
        },
        "tool_schema_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "seed_applied": {
          "type": "boolean"
        },
        "seed_status": {
          "type": "string"
        },
        "model_parameters": {
          "type": "object"
        },
        "budget_limits": {
          "type": "object"
        },
        "usage": {
          "type": "object",
          "required": [
            "input_tokens",
            "output_tokens",
            "estimated_input_tokens",
            "usage_source",
            "api_calls",
            "tool_calls",
            "wall_time_seconds",
            "cost_usd",
            "currency",
            "price_table_version"
          ],
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "estimated_input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "usage_source": {
              "type": "string"
            },
            "api_calls": {
              "type": "integer",
              "minimum": 0
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "wall_time_seconds": {
              "type": "number",
              "minimum": 0
            },
            "cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": "string"
            },
            "price_table_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "required": [
        "correctness",
        "reasoning",
        "robustness",
        "efficiency",
        "maintainability"
      ],
      "properties": {
        "correctness": {
          "$ref": "#/$defs/metric"
        },
        "reasoning": {
          "$ref": "#/$defs/metric"
        },
        "robustness": {
          "$ref": "#/$defs/metric"
        },
        "efficiency": {
          "$ref": "#/$defs/metric"
        },
        "maintainability": {
          "$ref": "#/$defs/metric"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "output_digest",
        "patch_digest",
        "trace_digest",
        "test_report_digest"
      ],
      "properties": {
        "output_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "patch_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_report_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_implemented",
            "not_applicable",
            "invalid"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
